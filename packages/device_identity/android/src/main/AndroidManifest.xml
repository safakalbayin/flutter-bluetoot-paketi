<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- Normal apps can use READ_PHONE_STATE for IMEI only before Android 10.
         No privileged permissions or location / network permissions requested. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" android:maxSdkVersion="28" />
</manifest>
